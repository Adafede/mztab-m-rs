# Generated by Cargo
/target/

# IDEs and OS metadata
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store

# Temporary files
**/*.rs.bk

# Gate outputs
lcov.info
mutants.out*/

# Local agent state (never committed)
.agent-work/
.claude/

# cargo-fuzz build output, working corpora and crash artifacts
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/fuzz-*.log

# The browser demo's generated module (./mk local:demo)
/crates/mztab-m-wasm/www/pkg/

# Bindings: build output (cargo, R CMD INSTALL, maturin)
/.venv/
/bindings/python/target/
/bindings/python/python/mztab_m/*.so
/bindings/python/python/mztab_m/*.pyd
__pycache__/
*.pyc
/bindings/r/src/rust/target/
/bindings/r/src/*.o
/bindings/r/src/*.so
/bindings/r/src/*.dll
