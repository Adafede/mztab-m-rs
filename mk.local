# Repository-specific settings for ./mk. Sourced by ./mk after mk.versions.
# Everything here belongs to this repository; mk and mk.versions are standard
# and kept in sync by the rusti-graben template's scripts/adopt.sh.
#
# LOCAL_CI_GATES=(task ...)       tasks added to ./mk ci (shown as local:task)
# LOCAL_NIGHTLY_GATES=(task ...)  tasks added to ./mk ci-nightly
# LOCAL_OVERRIDES=(gate=task ...) standard gates run as this repository's own task
# LOCAL_CARGO_TOOLS=(crate@x.y.z) extra tools, installed and version-checked like mk.versions
#                                 (`crate@x.y.z:binary` when the binary has another name)
# MIRI_PACKAGES / MUTANTS_PACKAGES: crates scoped for miri / mutants (default: workspace)

# Ratchet: may only go up (./mk ratchet).
COVERAGE_FAIL_UNDER_LINES="100"

# The standard wasm gate only runs `cargo check` on the whole workspace. This project's
# contract is stronger: the core must build *and pass its tests* on wasm32-unknown-unknown,
# with and without optional features. Crates with OS I/O (CLI) are not wasm targets.
# Nightly `miri` is scoped to `mztab-m --lib` and `mztab-m-obo` (the workspace forbids
# `unsafe_code`, while `mztab-m-cli` spawns subprocesses unsupported by Miri and the
# 35 MB corpus / 2,000-case proptests exceed nightly time budgets under Miri).
# Nightly `outdated` ignores `criterion`, which is pinned to 0.5 per DECISIONS.md D-073.
LOCAL_OVERRIDES=(wasm=wasm miri=miri outdated=outdated)
# Must equal the wasm-bindgen version in Cargo.lock (task_wasm checks it).
LOCAL_CARGO_TOOLS=(wasm-bindgen-cli@0.2.130:wasm-bindgen-test-runner mdbook@0.5.4 lychee@0.24.2)
WASM_CRATES=(mztab-m mztab-m-obo mztab-m-api mztab-m-wasm)

task_wasm() {
    local locked runner
    locked="$(awk '/^name = "wasm-bindgen"$/{getline; gsub(/version = |"/, ""); print}' Cargo.lock)"
    runner="$(wasm-bindgen-test-runner --version 2>/dev/null | awk '{print $2}')" ||
        die "wasm-bindgen-test-runner not found: run ./mk setup"
    [ "$locked" = "$runner" ] ||
        die "wasm-bindgen-test-runner $runner does not match wasm-bindgen $locked in Cargo.lock; bump LOCAL_CARGO_TOOLS"
    rustup target add wasm32-unknown-unknown
    local c
    for c in "${WASM_CRATES[@]}"; do
        cargo check -p "$c" --target wasm32-unknown-unknown --no-default-features --locked
        cargo check -p "$c" --target wasm32-unknown-unknown --all-features --locked
        CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner \
            cargo test -p "$c" --target wasm32-unknown-unknown --all-features --locked --lib --tests
    done
}

# The browser demo (crates/mztab-m-wasm/www): builds the module and its
# JavaScript glue into www/pkg (not committed). `./mk local:demo`; CI runs it
# so the page's module always builds. `fuzz` keeps fuzz targets and benches
# compiling in CI.
LOCAL_CI_GATES=(demo fuzz)

task_demo() {
    rustup target add wasm32-unknown-unknown
    cargo build -p mztab-m-wasm --target wasm32-unknown-unknown --release --locked
    wasm-bindgen --target web --no-typescript \
        --out-dir crates/mztab-m-wasm/www/pkg \
        target/wasm32-unknown-unknown/release/mztab_m_wasm.wasm
    cp third_party/mzTab-M/examples/2.1/example_study_variable_group.mztab \
        crates/mztab-m-wasm/www/pkg/example_study_variable_group.mztab
    echo "demo: serve crates/mztab-m-wasm/www (e.g. python3 -m http.server -d crates/mztab-m-wasm/www)"
}

task_fuzz() {
    cargo check --manifest-path fuzz/Cargo.toml --locked
    cargo check -p mztab-m-bench --benches --all-features --locked
}

task_findings() {
    ./scripts/generate-findings.sh
}

task_site() {
    need mdbook
    need lychee
    cargo test -p mztab-m --test findings_doc --locked
    rm -rf target/site
    mdbook build docs/site -d "$PWD/target/site"
    task_demo
    mkdir -p target/site/demo
    cp -R crates/mztab-m-wasm/www/. target/site/demo/
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps --locked
    mkdir -p target/site/api
    cp -R target/doc/. target/site/api/
    cat >target/site/api/index.html <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=mztab_m/index.html">
<title>mztab-m-rs API documentation</title>
</head>
<body>
<p>Redirecting to <a href="mztab_m/index.html"><code>mztab_m</code> API documentation</a>…</p>
</body>
</html>
HTML
    : >target/site/.nojekyll
    lychee --offline --include-fragments --root-dir "$PWD/target/site" --exclude-path 'target/site/api' target/site
}

task_site-serve() {
    task_site
    local port="${PORT:-8000}"
    echo "docs: http://127.0.0.1:${port}/"
    echo "demo: http://127.0.0.1:${port}/demo/"
    python3 -m http.server --bind 127.0.0.1 "$port" --directory target/site
}

task_bindings() {
    local target="${1:-all}"
    case "$target" in
        all | python | r) ;;
        *) die "usage: ./mk bindings [all|python|r]" ;;
    esac
    if [ "$target" = all ] || [ "$target" = python ]; then
        command -v python3 >/dev/null || die "python3 is required for Python bindings"
        local venv="$PWD/target/venv"
        local wheels="$PWD/target/wheels"
        mkdir -p "$wheels"
        rm -f "$wheels"/*.whl
        python3 -m venv "$venv"
        "$venv/bin/pip" install --quiet 'maturin==1.16.0'
        VIRTUAL_ENV="$venv" "$venv/bin/maturin" build --release --out "$wheels"
        "$venv/bin/pip" install --quiet --force-reinstall "$wheels"/*.whl
        "$venv/bin/python" -m unittest discover -s bindings/python/tests -v
        "$venv/bin/python" -c "import doctest, mztab_m, sys; sys.exit(doctest.testmod(mztab_m).failed)"
    fi
    if [ "$target" = all ] || [ "$target" = r ]; then
        command -v R >/dev/null || die "R is required for R bindings"
        command -v Rscript >/dev/null || die "Rscript is required for R bindings"
        mkdir -p target/rlib
        R CMD INSTALL --no-docs --library=target/rlib bindings/r
        R_LIBS=target/rlib Rscript -e 'library(testthat); library(mztabm); test_dir("bindings/r/tests/testthat", stop_on_failure = TRUE)'
    fi
}

# The corpus against the real PSI-MS vocabulary (D-077): downloads the pinned
# release (verified by SHA-256) into target/vocab and runs the golden test.
# Nightly, so a pull request never depends on the network beyond crates.
PSI_MS_VERSION="v4.2.17"
PSI_MS_SHA256="354b666d5f7277686f0c340d6d583f43021157563bde9ff61eb704d3566ffcf8"
LOCAL_NIGHTLY_GATES=(vocab)

task_vocab() {
    local obo="target/vocab/psi-ms-${PSI_MS_VERSION}.obo"
    mkdir -p target/vocab
    if [ ! -f "$obo" ]; then
        curl -fsSL -A "mztab-m-rs-vocab" -o "$obo.part" \
            "https://raw.githubusercontent.com/HUPO-PSI/psi-ms-CV/${PSI_MS_VERSION}/psi-ms.obo"
        mv "$obo.part" "$obo"
    fi
    echo "$PSI_MS_SHA256  $obo" | shasum -a 256 -c - >/dev/null ||
        die "$obo does not match the pinned SHA-256"
    PSI_MS_OBO="$PWD/$obo" cargo test -p mztab-m-api --test vocabulary --locked -- --ignored
}

task_miri() {
    cargo "+$RUST_NIGHTLY" miri --version >/dev/null 2>&1 || die "miri on $RUST_NIGHTLY is not installed; run ./mk setup nightly"
    export MIRIFLAGS="${MIRIFLAGS:--Zmiri-disable-isolation -Zmiri-tree-borrows}"
    cargo "+$RUST_NIGHTLY" miri test --all-features --locked -p mztab-m --lib
    cargo "+$RUST_NIGHTLY" miri test --all-features --locked -p mztab-m-obo
}

task_outdated() {
    need cargo-outdated
    cargo outdated --workspace --root-deps-only --ignore criterion --exit-code 1
}
